# 木序定制 · 全屋定制平台 环境变量示例
# 复制为 .env 后，把所有占位符替换为随机生成的强凭据（严禁提交真实值到仓库）。
# docker compose 会自动读取同目录 .env。

# MySQL root 密码（必填，随机强口令）
MYSQL_ROOT_PASSWORD=__CHANGE_ME_RANDOM_DB_PASSWORD__

# 业务数据库名（默认即可，可按需改）
MYSQL_DATABASE=whole_house_customization

# Django SECRET_KEY（必填，随机强口令，安装时随机生成）
DJANGO_SECRET_KEY=__CHANGE_ME_RANDOM_DJANGO_SECRET__

# Django 允许的主机（默认放开，可按需收敛为具体域名/IP）
DJANGO_ALLOWED_HOSTS=*

# 镜像标签（默认 latest；回滚时改为旧版本标签即可）
# WHC_IMAGE_TAG=latest
