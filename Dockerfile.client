# 木序定制 · 全屋定制平台 — 客户端镜像 (Vue3 → nginx 静态托管)
# 全链条闭环：优先从 Docker Hub 拉取 macttnk/whole-house-client:<tag>，
# 拉取失败时由 docker compose 用本文件自动兜底本地构建。
FROM node:22-alpine AS builder
WORKDIR /app
COPY client/@latest/package*.json ./
RUN npm ci || npm install
COPY client/@latest/ ./
RUN npm run build

FROM nginx:alpine
COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx.spa.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
